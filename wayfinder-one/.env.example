# One block per person: edit ONLY your own block. Defaults run the whole product offline.
# --- P1 ---
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_API_MODE=live            # live | fixtures
NEXT_PUBLIC_DEMO_MODE=1
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# --- P2 ---
ENV=dev
DATABASE_URL=postgresql+psycopg://wayfinder:wayfinder@localhost:5432/wayfinder
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me         # prod refuses this value
JWT_TTL_MIN=60
DEMO_MODE=1
SUPPLIER=mock                         # mock | tbo_live | hybrid
TBO_BASE_URL=
TBO_USERNAME=
TBO_PASSWORD=
TBO_CLIENT_ID=
